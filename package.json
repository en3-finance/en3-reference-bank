{
  "name": "en3-reference-bank",
  "version": "0.1.0",
  "private": true,
  "description": "Public mock reference bank stablecoin wallet demo for En3 sandbox concepts.",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n core,en3,web -c blue,green,magenta \"pnpm --filter @en3-reference-bank/mock-bank-core dev\" \"pnpm --filter @en3-reference-bank/mock-en3-api dev\" \"pnpm --filter @en3-reference-bank/customer-web dev\"",
    "sandbank:demo": "node scripts/run-sandbank-demo.mjs",
    "validate:forbidden": "sh -c '! rg -n \"audit\\.event_recorded|ledger\\.entry_created|reconciliation\\.entry_created\" apps packages mock'",
    "validate:secrets": "sh -c '! rg -n \"(ghp_|github_pat_|sk-[A-Za-z0-9]{20,}|-----BEGIN (RSA |EC |OPENSSH |)PRIVATE KEY-----|(?i)(api[_-]?key|secret|token|password)\\s*[:=])\" --glob \"!pnpm-lock.yaml\" --glob \"!CODEX_REPORT.md\" --glob \"!package.json\"'",
    "build": "pnpm -r build",
    "test": "pnpm --filter @en3-reference-bank/shared test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
